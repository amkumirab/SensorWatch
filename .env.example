SENSORWATCH_DATABASE_URL=sqlite:///./data/sensorwatch.db
SENSORWATCH_DETECTOR_WINDOW=40
SENSORWATCH_DETECTOR_MIN_SAMPLES=12
SENSORWATCH_DETECTOR_THRESHOLD=3.5
SENSORWATCH_DEMO_ENABLED=true
SENSORWATCH_INGEST_API_KEY=

# Docker Compose development database
POSTGRES_DB=sensorwatch
POSTGRES_USER=sensorwatch
POSTGRES_PASSWORD=sensorwatch-dev
